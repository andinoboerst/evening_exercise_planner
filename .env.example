# Supabase Connection
# (Both VITE_ and NEXT_PUBLIC_ prefixes are supported for client and SSR environments)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Household Access Security
# Comma-separated list of allowed Google account emails
ALLOWED_EMAILS=andino@example.com,nu@example.com

# Optional Service Role Key for elevated backend tasks
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Journal handwriting scan (server-side only, never prefix with VITE_)
# Free key from https://aistudio.google.com/apikey (no card needed)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
